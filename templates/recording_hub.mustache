{{!
  @template mod_googlemeet/recording_hub
}}
<div id="googlemeet-recording-hub" class="googlemeet-recording-hub" data-cmid="{{cmid}}" data-recordingid="{{recordingid}}" data-duration-seconds="{{durationseconds}}" data-hub-url="{{huburl}}" data-start-seconds="{{starttime}}">
  <div class="googlemeet-hub-nav mb-3">
    <a href="{{backurl}}" class="googlemeet-hub-back"><span aria-hidden="true">&lsaquo;</span> {{# str }} hub_back_to_recordings, mod_googlemeet {{/ str }}</a>
  </div>

  <header class="googlemeet-hub-heading googlemeet-hub-titlebar">
    <h3 class="googlemeet-hub-title">
      <span class="recording-name-text" title="{{originalname}}" data-originalname="{{originalname}}">{{name}}</span>
      {{#caneditrecording}}
        <button type="button" class="recordingeditname googlemeet-edit-btn googlemeet-button-reset ms-1" data-id="{{recordingid}}" title="{{# str }} edit {{/ str }}" aria-label="{{# str }} edit {{/ str }}">
          {{# pix }} i/edit, core {{/ pix }}
        </button>
      {{/caneditrecording}}
    </h3>
    {{#hassubtitle}}<div class="googlemeet-hub-subtitle">{{subtitle}}</div>{{/hassubtitle}}
    <div class="googlemeet-hub-meta">
      {{#datelabel}}<time datetime="{{datetimeiso}}">{{datelabel}}</time>{{/datelabel}}
      <span><span class="visually-hidden">{{# str }} hub_duration_label, mod_googlemeet {{/ str }}: </span>{{duration}}</span>
      {{#haschapters}}<span>{{# str }} hub_meta_chapters, mod_googlemeet, {{chaptercount}} {{/ str }}</span>{{/haschapters}}
    </div>
  </header>

  <div class="googlemeet-hub-media-layout {{#haschapters}}googlemeet-hub-media-with-chapters{{/haschapters}}">
    {{#canembed}}
      <div class="googlemeet-player-column">
        <div class="ratio ratio-16x9 mb-3 googlemeet-recording-player">
          <iframe src="{{playerurl}}" data-region="recording-player-iframe" data-embed-base="{{embedurl}}" allow="autoplay; encrypted-media" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="{{originalname}}"></iframe>
        </div>
        <div class="googlemeet-player-fallback mb-3">
          <span class="googlemeet-player-fallback-text">{{# str }} hub_player_fallback_text, mod_googlemeet {{/ str }}</span>
          <a href="{{webviewlink}}" class="googlemeet-player-fallback-link" target="_blank" rel="noopener">{{# str }} hub_player_fallback_link, mod_googlemeet {{/ str }}<span class="visually-hidden"> ({{# str }} hub_opens_new_tab, mod_googlemeet {{/ str }})</span></a>
          <details class="googlemeet-player-help">
            <summary>{{# str }} hub_player_help_why, mod_googlemeet {{/ str }}</summary>
            <p>{{# str }} player_help_body, mod_googlemeet {{/ str }}</p>
          </details>
        </div>
        <div class="visually-hidden" data-region="seek-feedback" aria-live="polite"></div>
        {{#hasresume}}
        <div class="googlemeet-resume-bar mb-3" data-region="resume-bar">
          <button type="button" class="btn btn-primary btn-sm googlemeet-resume-button" data-seek-seconds="{{resumeseconds}}"><span aria-hidden="true">&#9654;</span> {{resumelabel}}</button>
          <span class="googlemeet-resume-note" title="{{# str }} recording_resume_note, mod_googlemeet {{/ str }}">{{# str }} hub_resume_note, mod_googlemeet {{/ str }}</span>
        </div>
        {{/hasresume}}
      </div>
    {{/canembed}}
    {{^canembed}}
      <div class="googlemeet-recording-player-empty mb-3">
        <div class="googlemeet-recording-player-empty-icon" aria-hidden="true">{{# pix }} i/externallink, core {{/ pix }}</div>
        <p>{{# str }} recording_embed_unavailable, mod_googlemeet {{/ str }}</p>
        <p class="googlemeet-recording-player-empty-help">{{# str }} recording_embed_unavailable_help, mod_googlemeet {{/ str }}</p>
        <a href="{{webviewlink}}" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener">{{# str }} openindrive, mod_googlemeet {{/ str }}</a>
      </div>
    {{/canembed}}
    {{#haschapters}}
    <aside class="googlemeet-chapters-panel mb-3" aria-labelledby="googlemeet-chapters-title">
      <div class="googlemeet-chapters-header">
        <h4 id="googlemeet-chapters-title">{{# str }} hub_chapters_heading, mod_googlemeet {{/ str }} <span class="googlemeet-chapters-count">({{chaptercount}})</span></h4>
        <button type="button" class="btn btn-outline-secondary btn-sm googlemeet-chapters-toggle" aria-expanded="true" aria-controls="googlemeet-chapters-body" data-label-show="{{# str }} chapters_show, mod_googlemeet {{/ str }}" data-label-hide="{{# str }} chapters_hide, mod_googlemeet {{/ str }}">{{# str }} chapters_hide, mod_googlemeet {{/ str }}</button>
      </div>
      <div id="googlemeet-chapters-body" class="googlemeet-chapters-body">
      <p class="googlemeet-chapters-help">
        {{#canembed}}{{# str }} hub_chapters_hint_seek, mod_googlemeet {{/ str }}{{/canembed}}
        {{^canembed}}
          {{#caneditrecording}}{{# str }} chapters_teacher_hint, mod_googlemeet {{/ str }}{{/caneditrecording}}
          {{^caneditrecording}}{{# str }} chapters_student_hint, mod_googlemeet {{/ str }}{{/caneditrecording}}
        {{/canembed}}
      </p>
      <ol class="googlemeet-chapters-list">
        {{#chapters}}
        <li class="googlemeet-chapter-item">
          <button type="button" class="googlemeet-chapter-button" data-start-seconds="{{startseconds}}" data-chapter-timestamp="{{start}}" aria-label="{{chapterarialabel}}">
            <span class="googlemeet-chapter-time">{{start}}</span>
            <span class="googlemeet-chapter-title" title="{{title}}">{{title}}</span>
          </button>
          {{#canembed}}
          <button type="button" class="googlemeet-chapter-copylink googlemeet-button-reset" data-start-seconds="{{startseconds}}" data-chapter-timestamp="{{start}}" aria-label="{{# str }} chapter_copy_link_aria, mod_googlemeet, {{start}} {{/ str }}" title="{{# str }} chapter_copy_link, mod_googlemeet {{/ str }}">
            {{# pix }} t/copy, core {{/ pix }}
          </button>
          {{/canembed}}
        </li>
        {{/chapters}}
      </ol>
      </div>
      <div class="googlemeet-chapter-feedback" data-region="chapter-feedback" aria-live="polite"></div>
    </aside>
    {{/haschapters}}
  </div>

  <div class="googlemeet-hub-header">
    <div class="googlemeet-hub-statusbar">
      <div class="googlemeet-hub-progress" data-region="recording-progress" data-completed="{{#progresscompleted}}1{{/progresscompleted}}{{^progresscompleted}}0{{/progresscompleted}}" data-watchedseconds="{{progresswatchedseconds}}">
        <span class="googlemeet-progress-badge {{#progresscompleted}}googlemeet-progress-badge-completed{{/progresscompleted}}{{#progresspartial}}googlemeet-progress-badge-partial{{/progresspartial}}{{#progressunseen}}googlemeet-progress-badge-unseen{{/progressunseen}}" aria-live="polite" aria-label="{{progressarialabel}}">
          {{#progresscompleted}}<span aria-hidden="true">&#10003;</span>{{/progresscompleted}}
          {{#progressunseen}}<span aria-hidden="true">&#9675;</span>{{/progressunseen}}
          <span class="googlemeet-progress-status-text">{{progressstatuslabel}}</span>
        </span>
        {{#showprogressbar}}
          <div class="googlemeet-progress-line">
            <div class="progress googlemeet-progress-meter" role="progressbar" aria-label="{{# str }} recording_progress_meter, mod_googlemeet {{/ str }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progresspct}}">
              <div class="progress-bar" style="{{progressbarstyle}}"></div>
            </div>
            <span class="googlemeet-progress-percent">{{progresspcttext}}</span>
          </div>
        {{/showprogressbar}}
      </div>
      <button type="button" class="btn btn-sm googlemeet-mark-viewed {{#progresscompleted}}btn-outline-success{{/progresscompleted}}{{^progresscompleted}}btn-primary{{/progresscompleted}}" {{#progresscompleted}}disabled{{/progresscompleted}}>
        {{#progresscompleted}}{{# str }} recording_progress_completed, mod_googlemeet {{/ str }}{{/progresscompleted}}
        {{^progresscompleted}}{{# str }} recording_mark_viewed, mod_googlemeet {{/ str }}{{/progresscompleted}}
      </button>
      {{#caneditrecording}}
      <div class="googlemeet-hub-secondary-actions">
          <button type="button" class="btn btn-outline-secondary btn-sm recordinghowhide" data-id="{{recordingid}}" data-label-hide="{{# str }} recording_hide_from_students_button, mod_googlemeet {{/ str }}" data-label-show="{{# str }} recording_show_to_students_button, mod_googlemeet {{/ str }}">
            {{visibilitybuttonlabel}}
          </button>
      </div>
      {{/caneditrecording}}
    </div>
  </div>

  <div class="googlemeet-hub-tabs-wrap">
  <ul class="nav nav-tabs googlemeet-hub-tabs" role="tablist" aria-label="{{# str }} hub_tabs_aria, mod_googlemeet {{/ str }}">
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#summaryactive}}active{{/summaryactive}}" id="googlemeet-summary-tab" data-hub-tab="summary" data-bs-toggle="tab" data-bs-target="#googlemeet-summary-panel" type="button" role="tab" aria-controls="googlemeet-summary-panel" aria-selected="{{#summaryactive}}true{{/summaryactive}}{{^summaryactive}}false{{/summaryactive}}">
        {{# str }} hub_tab_summary, mod_googlemeet {{/ str }}
      </button>
    </li>
    {{#showquestionstab}}
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#questionsactive}}active{{/questionsactive}}" id="googlemeet-questions-tab" data-hub-tab="questions" data-bs-toggle="tab" data-bs-target="#googlemeet-questions-panel" type="button" role="tab" aria-controls="googlemeet-questions-panel" aria-selected="{{#questionsactive}}true{{/questionsactive}}{{^questionsactive}}false{{/questionsactive}}">
        {{# str }} hub_tab_questions, mod_googlemeet {{/ str }}
        {{#questioncount}}<span class="googlemeet-tab-count">{{questioncount}}</span>{{/questioncount}}
        {{#canmanagequestions}}{{#hasdrafts}}<span class="googlemeet-tab-count googlemeet-tab-count-warning">{{# str }} hub_tab_drafts, mod_googlemeet, {{draftcount}} {{/ str }}</span>{{/hasdrafts}}{{/canmanagequestions}}
      </button>
    </li>
    {{/showquestionstab}}
    {{#showmaterials}}
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#materialsactive}}active{{/materialsactive}}" id="googlemeet-materials-tab" data-hub-tab="materials" data-bs-toggle="tab" data-bs-target="#googlemeet-materials-panel" type="button" role="tab" aria-controls="googlemeet-materials-panel" aria-selected="{{#materialsactive}}true{{/materialsactive}}{{^materialsactive}}false{{/materialsactive}}">
        {{# str }} hub_tab_materials, mod_googlemeet {{/ str }}
        {{#materialcount}}<span class="googlemeet-tab-count">{{materialcount}}</span>{{/materialcount}}
      </button>
    </li>
    {{/showmaterials}}
    {{#caneditrecording}}
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="googlemeet-transcript-tab" data-hub-tab="transcript" data-bs-toggle="tab" data-bs-target="#googlemeet-transcript-panel" type="button" role="tab" aria-controls="googlemeet-transcript-panel" aria-selected="false">
        {{# str }} hub_tab_transcript, mod_googlemeet {{/ str }}
      </button>
    </li>
    {{/caneditrecording}}
    {{#hasnotes}}
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="googlemeet-notes-tab" data-hub-tab="notes" data-bs-toggle="tab" data-bs-target="#googlemeet-notes-panel" type="button" role="tab" aria-controls="googlemeet-notes-panel" aria-selected="false">
        {{# str }} hub_tab_notes_meet, mod_googlemeet {{/ str }}
      </button>
    </li>
    {{/hasnotes}}
  </ul>
  </div>

  <div class="tab-content pt-3">
    <div class="tab-pane fade {{#summaryactive}}show active{{/summaryactive}}" id="googlemeet-summary-panel" role="tabpanel" aria-labelledby="googlemeet-summary-tab">
      {{#hasanalysis}}
        <div class="googlemeet-study-toolbar">
          <span class="googlemeet-ai-origin">{{# str }} hub_ai_generated_note, mod_googlemeet {{/ str }}</span>
          <button type="button" class="btn btn-outline-secondary btn-sm googlemeet-print-summary d-none">{{# str }} hub_print_summary, mod_googlemeet {{/ str }}</button>
        </div>
        <div class="googlemeet-study-layout">
          <div class="googlemeet-study-main">
        <section class="googlemeet-ai-section googlemeet-ai-summary" aria-labelledby="googlemeet-hub-summary-title">
          <h4 id="googlemeet-hub-summary-title" class="googlemeet-hub-section-title">{{# str }} ai_summary, mod_googlemeet {{/ str }}</h4>
          <div class="googlemeet-ai-summary-body" id="googlemeet-ai-summary-body">{{{summary}}}</div>
          <button type="button" class="btn btn-link btn-sm px-0 googlemeet-readmore d-none" aria-expanded="false" aria-controls="googlemeet-ai-summary-body" data-label-more="{{# str }} hub_read_more, mod_googlemeet {{/ str }}" data-label-less="{{# str }} hub_read_less, mod_googlemeet {{/ str }}">{{# str }} hub_read_more, mod_googlemeet {{/ str }}</button>
        </section>
        {{#keypoints.0}}
        <section class="googlemeet-ai-section googlemeet-ai-keypoints" data-kp-hash="{{keypointshash}}" data-kp-state="{{keypointsstate}}" aria-labelledby="googlemeet-hub-keypoints-title">
          <div class="googlemeet-hub-section-head">
            <h4 id="googlemeet-hub-keypoints-title" class="googlemeet-hub-section-title">{{# str }} ai_keypoints, mod_googlemeet {{/ str }} <span class="googlemeet-hub-section-count">{{keypointcount}}</span></h4>
            <span class="googlemeet-keypoints-progress d-none" aria-live="polite" data-template="{{# str }} hub_keypoints_reviewed, mod_googlemeet {{/ str }}"></span>
          </div>
          <p class="googlemeet-keypoints-hint d-none">{{# str }} hub_keypoints_hint, mod_googlemeet {{/ str }}</p>
          <ol class="googlemeet-keypoints-checklist">
            {{#keypoints}}
            <li class="googlemeet-keypoint">
              <input type="checkbox" class="form-check-input googlemeet-keypoint-check d-none" id="googlemeet-keypoint-{{number}}" aria-label="{{# str }} hub_keypoint_check_aria, mod_googlemeet, {{number}} {{/ str }}">
              <span class="googlemeet-keypoint-number" aria-hidden="true">{{number}}</span>
              <span class="googlemeet-keypoint-text">{{text}}</span>
            </li>
            {{/keypoints}}
          </ol>
        </section>
        {{/keypoints.0}}
          </div>
        <aside class="googlemeet-study-aside" aria-label="{{# str }} hub_study_aside_aria, mod_googlemeet {{/ str }}">
        {{#topics.0}}
        <section class="googlemeet-ai-section googlemeet-ai-topics" aria-labelledby="googlemeet-hub-topics-title">
          <h4 id="googlemeet-hub-topics-title" class="googlemeet-hub-section-title">{{# str }} ai_topics, mod_googlemeet {{/ str }}</h4>
          <p class="googlemeet-topics-hint">{{# str }} hub_topics_hint, mod_googlemeet {{/ str }}</p>
          <ul class="googlemeet-hub-topics" role="list">
            {{#topics}}<li><a class="googlemeet-hub-topic" href="{{url}}" title="{{# str }} hub_topic_link_aria, mod_googlemeet, {{text}} {{/ str }}">{{text}}</a></li>{{/topics}}
          </ul>
        </section>
        {{/topics.0}}
          {{^canmanagequestions}}{{#hasquestions}}
          <section class="googlemeet-ai-section googlemeet-study-cta">
            <h4 class="googlemeet-hub-section-title">{{# str }} hub_cta_practice_title, mod_googlemeet {{/ str }}</h4>
            <p>{{# str }} hub_cta_practice_text, mod_googlemeet, {{questioncount}} {{/ str }}</p>
            <button type="button" class="btn btn-primary btn-sm" data-hub-goto="questions">{{# str }} hub_cta_practice_button, mod_googlemeet {{/ str }}</button>
          </section>
          {{/hasquestions}}{{/canmanagequestions}}
          {{#hasmaterials}}
          <section class="googlemeet-ai-section googlemeet-study-cta googlemeet-study-cta-materials">
            <h4 class="googlemeet-hub-section-title">{{# str }} hub_tab_materials, mod_googlemeet {{/ str }} <span class="googlemeet-hub-section-count">{{materialcount}}</span></h4>
            <button type="button" class="btn btn-outline-primary btn-sm" data-hub-goto="materials">{{# str }} hub_cta_materials_button, mod_googlemeet {{/ str }}</button>
          </section>
          {{/hasmaterials}}
        </aside>
        </div>
      {{/hasanalysis}}
      {{^hasanalysis}}
        {{#aistatusisprocessing}}<div class="alert alert-info">{{# str }} ai_status_chip_processing, mod_googlemeet {{/ str }}</div>{{/aistatusisprocessing}}
        {{#aistatusispending}}<div class="alert alert-info">{{# str }} ai_status_chip_pending, mod_googlemeet {{/ str }}</div>{{/aistatusispending}}
        {{#aistatusisfailed}}<div class="alert alert-warning" role="alert">{{# str }} ai_status_chip_failed_student, mod_googlemeet {{/ str }}{{#aierror}}<div class="small text-muted mt-1">{{aierror}}</div>{{/aierror}}</div>{{/aistatusisfailed}}
        {{^aistatusisprocessing}}{{^aistatusispending}}{{^aistatusisfailed}}
          {{#aienabled}}<div class="alert alert-info">{{# str }} ai_noanalysis, mod_googlemeet {{/ str }}</div>{{/aienabled}}
          {{^aienabled}}<div class="alert alert-secondary">{{# str }} ai_notconfigured, mod_googlemeet {{/ str }}</div>{{/aienabled}}
        {{/aistatusisfailed}}{{/aistatusispending}}{{/aistatusisprocessing}}
      {{/hasanalysis}}
    </div>

    {{#showquestionstab}}
    <div class="tab-pane fade {{#questionsactive}}show active{{/questionsactive}}" id="googlemeet-questions-panel" role="tabpanel" aria-labelledby="googlemeet-questions-tab">
      {{#canmanagequestions}}
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <div>
            <strong>{{questioncount}}</strong> {{# str }} hub_tab_questions, mod_googlemeet {{/ str }}
            {{#draftcount}}<span class="badge bg-warning text-dark ms-1">{{draftcount}} {{# str }} question_status_draft, mod_googlemeet {{/ str }}</span>{{/draftcount}}
            {{#publishedcount}}<span class="badge bg-success ms-1">{{publishedcount}} {{# str }} question_status_published, mod_googlemeet {{/ str }}</span>{{/publishedcount}}
          </div>
          <div class="d-flex gap-2 flex-wrap">
          {{#activitydraftcount}}
          <button type="button" class="btn btn-outline-secondary btn-sm googlemeet-question-publish-activity" data-count="{{activitydraftcount}}">{{# str }} question_publish_activity_count, mod_googlemeet, {{activitydraftcount}} {{/ str }}</button>
          {{/activitydraftcount}}
          {{#aienabled}}
          <button type="button" class="btn btn-primary btn-sm googlemeet-question-generate" data-count="10" {{#generationqueued}}disabled{{/generationqueued}}>
            {{#generationqueued}}{{# str }} question_generating, mod_googlemeet {{/ str }}{{/generationqueued}}
            {{^generationqueued}}
              {{#hasquestions}}{{# str }} question_generate_more, mod_googlemeet {{/ str }}{{/hasquestions}}
              {{^hasquestions}}{{# str }} question_generate_ai, mod_googlemeet {{/ str }}{{/hasquestions}}
            {{/generationqueued}}
          </button>
          {{/aienabled}}
          </div>
        </div>
        {{#generationqueued}}
          <div class="alert alert-info googlemeet-question-generating">{{# str }} question_generating, mod_googlemeet {{/ str }}</div>
        {{/generationqueued}}
        {{^hasquestions}}
          <div class="alert alert-secondary">{{# str }} question_empty_teacher, mod_googlemeet {{/ str }}</div>
        {{/hasquestions}}
        {{#hasquestions}}
          <div class="googlemeet-question-bulkbar mb-3" role="group" aria-label="{{# str }} question_bulk_actions, mod_googlemeet {{/ str }}">
            <div class="form-check mb-0 googlemeet-question-selectall-wrap">
              <input class="form-check-input googlemeet-question-select-all" type="checkbox" id="googlemeet-question-select-all">
              <label class="form-check-label" for="googlemeet-question-select-all">{{# str }} question_select_all, mod_googlemeet {{/ str }}</label>
            </div>
            <button type="button" class="btn btn-primary btn-sm googlemeet-question-bulk-publish" disabled>{{# str }} question_bulk_publish_count, mod_googlemeet, 0 {{/ str }}</button>
            <button type="button" class="btn btn-outline-danger btn-sm googlemeet-question-bulk-discard" disabled>{{# str }} question_bulk_discard, mod_googlemeet {{/ str }}</button>
            {{#hasdrafts}}<button type="button" class="btn btn-outline-primary btn-sm googlemeet-question-publish-recording">{{# str }} question_publish_recording_count, mod_googlemeet, {{draftcount}} {{/ str }}</button>{{/hasdrafts}}
          </div>
          <div class="googlemeet-question-bulk-status" role="status" aria-live="polite"></div>
          <div class="googlemeet-question-list">
            {{#questions}}
              <div class="card mb-3 googlemeet-question-card" data-questionid="{{id}}">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="d-flex align-items-start gap-2" style="min-width:0;">
                      <input class="form-check-input mt-1 flex-shrink-0 googlemeet-question-select" type="checkbox" value="{{id}}" id="googlemeet-question-select-{{id}}" data-isdraft="{{#isdraft}}1{{/isdraft}}{{^isdraft}}0{{/isdraft}}">
                      <label class="fw-bold mb-0 text-break" for="googlemeet-question-select-{{id}}">{{{stem}}}</label>
                    </div>
                    <span class="badge flex-shrink-0 {{#isready}}bg-success{{/isready}}{{#isdraft}}bg-warning text-dark{{/isdraft}}">{{statuslabel}}</span>
                  </div>
                  <ol class="mt-2">
                    {{#answers}}
                      <li class="googlemeet-question-answer{{#correct}} googlemeet-question-answer-correct{{/correct}}">{{{text}}}{{#correct}} <span class="googlemeet-question-correct-tag"><span aria-hidden="true">&#10003;</span> {{# str }} question_answer_correct, mod_googlemeet {{/ str }}</span>{{/correct}}</li>
                    {{/answers}}
                  </ol>
                  <div class="border-top pt-2 small">{{{generalfeedback}}}</div>
                  <div class="d-flex gap-2 flex-wrap mt-3">
                    {{#isdraft}}<button type="button" class="btn btn-success btn-sm googlemeet-question-publish">{{# str }} question_publish, mod_googlemeet {{/ str }}</button>{{/isdraft}}
                    {{#isready}}<button type="button" class="btn btn-outline-warning btn-sm googlemeet-question-unpublish">{{# str }} question_unpublish, mod_googlemeet {{/ str }}</button>{{/isready}}
                    {{#isdraft}}<button type="button" class="btn btn-outline-danger btn-sm googlemeet-question-discard">{{# str }} question_discard, mod_googlemeet {{/ str }}</button>{{/isdraft}}
                    <button type="button" class="btn btn-outline-secondary btn-sm googlemeet-question-edit"
                      data-stem="{{stemplain}}"
                      data-feedback="{{generalfeedbackplain}}"
                      data-correctindex="{{correctindex}}"
                      {{#answers}}
                        data-answer{{index}}="{{plain}}"
                      {{/answers}}>
                      {{# str }} question_edit, mod_googlemeet {{/ str }}
                    </button>
                    <a href="{{advancedurl}}" class="btn btn-link btn-sm">{{# str }} question_advanced_edit, mod_googlemeet {{/ str }}</a>
                  </div>
                </div>
              </div>
            {{/questions}}
          </div>
        {{/hasquestions}}
      {{/canmanagequestions}}
      {{^canmanagequestions}}
        {{#hasquestions}}
          <div class="googlemeet-practice-player" data-loaded="0" data-progress-tpl="{{# str }} practice_progress, mod_googlemeet {{/ str }}">
            <div class="googlemeet-practice-head">
              <h4 class="googlemeet-hub-section-title mb-0">{{# str }} practice_title, mod_googlemeet {{/ str }}</h4>
              <span class="googlemeet-practice-progress" aria-live="polite"></span>
              <span class="googlemeet-practice-livescore d-none" data-template="{{# str }} practice_live_score, mod_googlemeet {{/ str }}"></span>
            </div>
            <div class="progress googlemeet-practice-meter d-none" role="progressbar" aria-label="{{# str }} practice_title, mod_googlemeet {{/ str }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div class="progress-bar"></div>
            </div>
            <div class="googlemeet-practice-loading alert alert-info">{{# str }} practice_loading, mod_googlemeet {{/ str }}</div>
            <div class="googlemeet-practice-error alert alert-danger d-none" role="alert"></div>
            <div class="googlemeet-practice-question d-none">
              <fieldset class="googlemeet-practice-fieldset">
                <legend class="googlemeet-practice-stem"></legend>
                <div class="googlemeet-practice-options"></div>
              </fieldset>
              <div class="googlemeet-practice-feedback d-none" aria-live="polite"></div>
              <div class="googlemeet-practice-actions">
                <button type="button" class="btn btn-primary googlemeet-practice-check" disabled>{{# str }} practice_check, mod_googlemeet {{/ str }}</button>
                <button type="button" class="btn btn-primary googlemeet-practice-next d-none">{{# str }} practice_next, mod_googlemeet {{/ str }}</button>
              </div>
            </div>
            <div class="googlemeet-practice-complete d-none" tabindex="-1">
              <div class="googlemeet-practice-score" aria-live="polite">
                <span class="googlemeet-practice-score-value"></span>
                <span class="googlemeet-practice-score-text" data-template="{{# str }} practice_score, mod_googlemeet {{/ str }}"></span>
              </div>
              <p class="googlemeet-practice-message mb-3"
                 data-great="{{# str }} practice_result_great, mod_googlemeet {{/ str }}"
                 data-good="{{# str }} practice_result_good, mod_googlemeet {{/ str }}"
                 data-low="{{# str }} practice_result_low, mod_googlemeet {{/ str }}"></p>
              <div class="googlemeet-practice-actions">
                <button type="button" class="btn btn-primary googlemeet-practice-review d-none" data-template="{{# str }} practice_review_wrong, mod_googlemeet {{/ str }}"></button>
                <button type="button" class="btn btn-outline-primary googlemeet-practice-retry">{{# str }} practice_retry_all, mod_googlemeet {{/ str }}</button>
                <button type="button" class="btn btn-link googlemeet-practice-tosummary" data-hub-goto="summary">{{# str }} practice_back_to_summary, mod_googlemeet {{/ str }}</button>
              </div>
            </div>
          </div>
        {{/hasquestions}}
        {{^hasquestions}}
          <div class="alert alert-secondary">{{# str }} question_empty_student, mod_googlemeet {{/ str }}</div>
        {{/hasquestions}}
      {{/canmanagequestions}}
    </div>
    {{/showquestionstab}}

    {{#showmaterials}}
    <div class="tab-pane fade {{#materialsactive}}show active{{/materialsactive}}" id="googlemeet-materials-panel" role="tabpanel" aria-labelledby="googlemeet-materials-tab">
      {{#caneditrecording}}{{#hasmaterials}}
        <div class="d-flex justify-content-end mb-3">
          <a href="{{managematerialsurl}}" class="btn btn-primary btn-sm">{{# str }} materials_manage, mod_googlemeet {{/ str }}</a>
        </div>
      {{/hasmaterials}}{{/caneditrecording}}
      {{#hasmaterials}}
        <div class="googlemeet-materials-list googlemeet-hub-materials-list">
          {{#materials}}
            <div class="googlemeet-material-row googlemeet-hub-material-row">
              <span class="googlemeet-material-file">
                <img src="{{icon}}" class="googlemeet-material-icon" alt="" aria-hidden="true">
                <span class="googlemeet-material-details">
                  <span class="googlemeet-material-name">{{name}}</span>
                  <span class="googlemeet-material-meta">{{size}} &middot; {{modified}}{{#filepath}} &middot; {{filepath}}{{/filepath}}</span>
                </span>
              </span>
              <a href="{{url}}" class="btn btn-outline-secondary btn-sm flex-shrink-0" aria-label="{{# str }} download {{/ str }}: {{name}}">{{# str }} download {{/ str }}</a>
            </div>
          {{/materials}}
        </div>
      {{/hasmaterials}}
      {{^hasmaterials}}
        {{#caneditrecording}}
          <div class="alert alert-secondary">{{# str }} materials_empty_teacher, mod_googlemeet {{/ str }}</div>
          <a href="{{managematerialsurl}}" class="btn btn-primary btn-sm">{{# str }} materials_manage, mod_googlemeet {{/ str }}</a>
        {{/caneditrecording}}
        {{^caneditrecording}}
          <div class="alert alert-secondary">{{# str }} materials_none, mod_googlemeet {{/ str }}</div>
        {{/caneditrecording}}
      {{/hasmaterials}}
    </div>
    {{/showmaterials}}

    {{#caneditrecording}}
    <div class="tab-pane fade" id="googlemeet-transcript-panel" role="tabpanel" aria-labelledby="googlemeet-transcript-tab">
      {{#hasanalysis}}
      {{#hastranscript}}
        <div class="googlemeet-transcript-search mb-3" role="search">
          <label class="visually-hidden" for="googlemeet-transcript-search-input">{{# str }} transcript_search_label, mod_googlemeet {{/ str }}</label>
          <input type="search" id="googlemeet-transcript-search-input" class="form-control form-control-sm googlemeet-transcript-search-input" placeholder="{{# str }} transcript_search_placeholder, mod_googlemeet {{/ str }}" autocomplete="off" aria-describedby="googlemeet-transcript-search-status">
          <span id="googlemeet-transcript-search-status" class="googlemeet-transcript-search-status" aria-live="polite"></span>
        </div>
        <div class="googlemeet-ai-transcript-text">{{{transcript}}}</div>
      {{/hastranscript}}
      {{^hastranscript}}<div class="alert alert-info">{{# str }} ai_transcript_unavailable, mod_googlemeet {{/ str }}</div>{{/hastranscript}}
      {{/hasanalysis}}
      {{^hasanalysis}}<div class="alert alert-info">{{# str }} ai_transcript_loading, mod_googlemeet {{/ str }}</div>{{/hasanalysis}}
    </div>
    {{/caneditrecording}}
    {{#hasnotes}}
    <div class="tab-pane fade" id="googlemeet-notes-panel" role="tabpanel" aria-labelledby="googlemeet-notes-tab">
      <p class="googlemeet-notes-origin">{{# str }} hub_notes_origin, mod_googlemeet {{/ str }}</p>
      <div class="googlemeet-ai-notes-document">
        <div class="googlemeet-ai-notes-text">{{{notes}}}</div>
      </div>
    </div>
    {{/hasnotes}}
  </div>

  {{#hasrecordingnav}}
    <nav class="googlemeet-hub-pager mt-4" aria-label="{{# str }} hub_lesson_nav_aria, mod_googlemeet {{/ str }}">
      {{#haspreviousrecording}}
        <a href="{{previousrecordingurl}}" class="googlemeet-hub-pager-link googlemeet-hub-pager-prev">
          <span class="googlemeet-hub-pager-label"><span aria-hidden="true">&lsaquo;</span> {{# str }} hub_previous_lesson, mod_googlemeet {{/ str }}</span>
          <span class="googlemeet-hub-pager-title">{{previousrecordingtitle}}</span>
          <span class="googlemeet-hub-pager-date">{{previousrecordingdate}}</span>
        </a>
      {{/haspreviousrecording}}
      {{#hasnextrecording}}
        <a href="{{nextrecordingurl}}" class="googlemeet-hub-pager-link googlemeet-hub-pager-next">
          <span class="googlemeet-hub-pager-label">{{# str }} hub_next_lesson, mod_googlemeet {{/ str }} <span aria-hidden="true">&rsaquo;</span></span>
          <span class="googlemeet-hub-pager-title">{{nextrecordingtitle}}</span>
          <span class="googlemeet-hub-pager-date">{{nextrecordingdate}}</span>
        </a>
      {{/hasnextrecording}}
    </nav>
  {{/hasrecordingnav}}

  <div class="modal fade" id="googlemeet-question-edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">{{# str }} question_edit, mod_googlemeet {{/ str }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{# str }} closebuttontitle {{/ str }}"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="googlemeet-question-edit-id">
          <div class="mb-2">
            <label class="form-label" for="googlemeet-question-edit-stem">{{# str }} question_stem, mod_googlemeet {{/ str }}</label>
            <textarea class="form-control" id="googlemeet-question-edit-stem" rows="3"></textarea>
          </div>
          <div class="row">
            <div class="col-md-6 mb-2"><div class="input-group"><span class="input-group-text">A</span><input class="form-control googlemeet-question-edit-answer" data-index="0" aria-label="A"></div></div>
            <div class="col-md-6 mb-2"><div class="input-group"><span class="input-group-text">B</span><input class="form-control googlemeet-question-edit-answer" data-index="1" aria-label="B"></div></div>
            <div class="col-md-6 mb-2"><div class="input-group"><span class="input-group-text">C</span><input class="form-control googlemeet-question-edit-answer" data-index="2" aria-label="C"></div></div>
            <div class="col-md-6 mb-2"><div class="input-group"><span class="input-group-text">D</span><input class="form-control googlemeet-question-edit-answer" data-index="3" aria-label="D"></div></div>
          </div>
          <div class="mb-2">
            <label class="form-label" for="googlemeet-question-edit-correct">{{# str }} question_correct_answer, mod_googlemeet {{/ str }}</label>
            <select class="form-select" id="googlemeet-question-edit-correct">
              <option value="0">A</option><option value="1">B</option><option value="2">C</option><option value="3">D</option>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label" for="googlemeet-question-edit-feedback">{{# str }} question_explanation, mod_googlemeet {{/ str }}</label>
            <textarea class="form-control" id="googlemeet-question-edit-feedback" rows="4"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{# str }} cancel {{/ str }}</button>
          <button type="button" class="btn btn-primary" id="googlemeet-question-edit-save">{{# str }} savechanges {{/ str }}</button>
        </div>
      </div>
    </div>
  </div>
</div>

{{#js}}
require(['mod_googlemeet/recording_hub'], function(m) {
  m.init({
    cmid: {{cmid}},
    recordingid: {{recordingid}},
    sesskey: {{# quote }}{{sesskey}}{{/ quote }},
    caneditrecording: {{#caneditrecording}}true{{/caneditrecording}}{{^caneditrecording}}false{{/caneditrecording}},
    canmanagequestions: {{#canmanagequestions}}true{{/canmanagequestions}}{{^canmanagequestions}}false{{/canmanagequestions}},
    hasquestions: {{#hasquestions}}true{{/hasquestions}}{{^hasquestions}}false{{/hasquestions}},
    progresscompleted: {{#progresscompleted}}true{{/progresscompleted}}{{^progresscompleted}}false{{/progresscompleted}},
    progresswatchedseconds: {{progresswatchedseconds}},
    progressthresholdseconds: {{progressthresholdseconds}}
  });
});
{{#canmanagequestions}}
require(['mod_googlemeet/question_review'], function(q) {
  q.init({cmid: {{cmid}}, recordingid: {{recordingid}}, sesskey: {{# quote }}{{sesskey}}{{/ quote }}});
});
{{/canmanagequestions}}
{{/js}}
