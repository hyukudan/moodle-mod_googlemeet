{{!
    @template mod_googlemeet/practice_page

    Activity-wide practice landing: review failed questions or practise by topic.

    Example context (json):
    {
        "backurl": "#", "failedcount": 3, "hasfailed": true, "failedurl": "#",
        "hastopics": true,
        "topics": [{"topic": "Constitución", "url": "#", "meta": "2 clases · 12 preguntas"}]
    }
}}
<div class="googlemeet-practice-landing">
  <p><a href="{{backurl}}" class="googlemeet-practice-back">&larr; {{# str }} practice_back_activity, mod_googlemeet {{/ str }}</a></p>
  <div class="googlemeet-practice-landing-grid">
    <section class="googlemeet-practice-landing-card" aria-labelledby="googlemeet-practice-failed-title">
      <h3 id="googlemeet-practice-failed-title" class="h5">{{# str }} practice_failed_title, mod_googlemeet {{/ str }}</h3>
      {{#hasfailed}}
        <p>{{# str }} practice_failed_text, mod_googlemeet, {{failedcount}} {{/ str }}</p>
        <a href="{{failedurl}}" class="btn btn-primary">{{# str }} practice_failed_start, mod_googlemeet {{/ str }}</a>
      {{/hasfailed}}
      {{^hasfailed}}
        <p class="text-muted mb-0">{{# str }} practice_failed_none, mod_googlemeet {{/ str }}</p>
      {{/hasfailed}}
    </section>
    <section class="googlemeet-practice-landing-card" aria-labelledby="googlemeet-practice-topic-title">
      <h3 id="googlemeet-practice-topic-title" class="h5">{{# str }} practice_topic_title, mod_googlemeet {{/ str }}</h3>
      {{#hastopics}}
        <p>{{# str }} practice_topic_text, mod_googlemeet {{/ str }}</p>
        <ul class="googlemeet-practice-topic-list">
          {{#topics}}
            <li><a href="{{url}}" class="googlemeet-practice-topic"><span class="googlemeet-practice-topic-name">{{topic}}</span><span class="googlemeet-practice-topic-meta">{{meta}}</span></a></li>
          {{/topics}}
        </ul>
      {{/hastopics}}
      {{^hastopics}}
        <p class="text-muted mb-0">{{# str }} practice_topic_none, mod_googlemeet {{/ str }}</p>
      {{/hastopics}}
    </section>
  </div>
</div>
