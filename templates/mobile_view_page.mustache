{{!
  @template mod_googlemeet/mobile_view_page

  Moodle App: activity view (UX-05). Description, join button, upcoming sessions and a paginated
  list of classes. Angular uses double braces, so the Mustache delimiters are switched to <% %>.

  Example context (json):
  {
    "cmid": 3,
    "courseid": 2,
    "intro": "<p>Clases de los martes</p>",
    "hasroom": true,
    "upcomingevent": {
      "hasupcomingevents": 1,
      "upcomingevents": [{"today": false, "startdate": "Tue. 17 Nov."}],
      "starttime": "09:00",
      "endtime": "10:00",
      "duration": 3600
    },
    "recording": {
      "hasrecordings": true,
      "recordings": [
        {"id": 1, "title": "Tema 4: el acto administrativo", "subtitle": "", "date": "Tuesday, 17 November 2026",
         "duration": "1:02:00", "watched": true}
      ],
      "haspages": true,
      "hasprev": false,
      "hasnext": true,
      "prevpage": 0,
      "nextpage": 1,
      "pagelabel": "Page 1 of 3"
    }
  }
}}
{{=<% %>=}}
<div>
  <%#intro%>
    <ion-card>
      <ion-card-content>
        <core-format-text text="<% intro %>" component="mod_googlemeet" componentId="<% cmid %>" contextLevel="module" contextInstanceId="<% cmid %>" [courseId]="<% courseid %>" [filter]="false"></core-format-text>
      </ion-card-content>
    </ion-card>
  <%/intro%>

  <%#hasroom%>
    <ion-button id="googlemeet-mobile-join" class="ion-margin" expand="block"
      core-site-plugins-call-ws
      name="mod_googlemeet_log_room_entered"
      [params]="{coursemoduleid: <% cmid %>, via: 'mobile'}"
      [preSets]="{getFromCache: 0, saveToCache: 0}"
      [showError]="false"
      (onSuccess)="googlemeetOpen($event.url || CONTENT_OTHERDATA.roomurl)"
      (onError)="googlemeetOpen(CONTENT_OTHERDATA.roomurl)">
      <ion-icon slot="start" name="videocam" aria-hidden="true"></ion-icon>
      {{ 'plugin.mod_googlemeet.entertheroom' | translate }}
    </ion-button>
  <%/hasroom%>

  <%#upcomingevent.hasupcomingevents%>
    <ion-list>
      <ion-item button lines="full" (click)="showUpcomingEvents = !showUpcomingEvents" [attr.aria-expanded]="showUpcomingEvents">
        <ion-label><h2>{{ 'plugin.mod_googlemeet.upcomingevents' | translate }}</h2></ion-label>
        <ion-icon slot="end" [name]="showUpcomingEvents ? 'chevron-up' : 'chevron-down'" aria-hidden="true"></ion-icon>
      </ion-item>
      <div *ngIf="showUpcomingEvents">
        <%#upcomingevent.upcomingevents%>
          <ion-item lines="full">
            <ion-icon slot="start" name="calendar-outline" aria-hidden="true"></ion-icon>
            <ion-label>
              <%#today%>{{ 'plugin.mod_googlemeet.today' | translate }}, <%/today%><%startdate%>
            </ion-label>
          </ion-item>
        <%/upcomingevent.upcomingevents%>
        <ion-item lines="full">
          <ion-icon slot="start" name="time-outline" aria-hidden="true"></ion-icon>
          <ion-label>
            <%#upcomingevent.duration%>
              {{ 'plugin.mod_googlemeet.from' | translate }} <%upcomingevent.starttime%>
              {{ 'plugin.mod_googlemeet.to' | translate }} <%upcomingevent.endtime%>
            <%/upcomingevent.duration%>
            <%^upcomingevent.duration%><%upcomingevent.starttime%><%/upcomingevent.duration%>
          </ion-label>
        </ion-item>
      </div>
    </ion-list>
  <%/upcomingevent.hasupcomingevents%>

  <%#recording.hasrecordings%>
    <ion-list>
      <ion-list-header>
        <ion-label><h2>{{ 'plugin.mod_googlemeet.recordings' | translate }}</h2></ion-label>
      </ion-list-header>
      <%#recording.recordings%>
        <ion-item button detail="true" lines="full"
          core-site-plugins-new-content
          component="mod_googlemeet"
          method="mobile_recording_view"
          [args]="{cmid: <% cmid %>, courseid: <% courseid %>, recordingid: <% id %>}"
          title="<% title %>">
          <ion-label>
            <h2><% title %></h2>
            <%#subtitle%><p><% subtitle %></p><%/subtitle%>
            <p><% date %><%#duration%> · <% duration %><%/duration%></p>
          </ion-label>
          <%#watched%>
            <ion-icon slot="end" name="checkmark-circle" color="success" [attr.aria-label]="'plugin.mod_googlemeet.recording_progress_completed' | translate"></ion-icon>
          <%/watched%>
        </ion-item>
      <%/recording.recordings%>
    </ion-list>

    <%#recording.haspages%>
      <ion-grid>
        <ion-row class="ion-align-items-center">
          <ion-col size="4">
            <%#recording.hasprev%>
              <ion-button fill="outline" expand="block" (click)="updateContent({cmid: <% cmid %>, courseid: <% courseid %>, page: <% recording.prevpage %>})">
                {{ 'plugin.mod_googlemeet.mobile_prev' | translate }}
              </ion-button>
            <%/recording.hasprev%>
          </ion-col>
          <ion-col size="4" class="ion-text-center"><% recording.pagelabel %></ion-col>
          <ion-col size="4">
            <%#recording.hasnext%>
              <ion-button fill="outline" expand="block" (click)="updateContent({cmid: <% cmid %>, courseid: <% courseid %>, page: <% recording.nextpage %>})">
                {{ 'plugin.mod_googlemeet.mobile_next' | translate }}
              </ion-button>
            <%/recording.hasnext%>
          </ion-col>
        </ion-row>
      </ion-grid>
    <%/recording.haspages%>
  <%/recording.hasrecordings%>
</div>
