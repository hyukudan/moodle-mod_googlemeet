{{!
    @template mod_googlemeet/ai_review_hub

    Teacher-only notices above the hub summary: IA-04 "pending review" banner and F-8 "stuck" alert.

    Example context (json):
    {
        "aipendingreview": true,
        "aistatusisstuck": false,
        "aistuckmessage": "",
        "aireviewcmid": 5,
        "aireviewrecordingid": 12
    }
}}
{{#aipendingreview}}
<div class="alert alert-warning googlemeet-ai-review-banner" role="status" data-region="ai-review-banner">
  <div class="googlemeet-ai-review-banner-text">
    <strong>{{# str }} aireview_pending_title, mod_googlemeet {{/ str }}</strong>
    <div class="small">{{# str }} aireview_pending_hint, mod_googlemeet {{/ str }}</div>
  </div>
  <button type="button" class="btn btn-primary btn-sm googlemeet-ai-review-publish" data-action="ai-review-publish" data-cmid="{{aireviewcmid}}" data-recordingid="{{aireviewrecordingid}}" data-seen="{{aireviewseen}}">{{# str }} aireview_publish, mod_googlemeet {{/ str }}</button>
</div>
{{/aipendingreview}}
{{#aistatusisstuck}}
<div class="alert alert-danger googlemeet-ai-stuck" role="alert" data-region="ai-stuck">
  <div>{{aistuckmessage}}</div>
  <button type="button" class="btn btn-outline-danger btn-sm mt-2" data-action="ai-stuck-retry" data-cmid="{{aireviewcmid}}" data-recordingid="{{aireviewrecordingid}}">{{# str }} ai_stuck_retry, mod_googlemeet {{/ str }}</button>
</div>
{{/aistatusisstuck}}
{{#js}}
{{#aipendingreview}}
require(['mod_googlemeet/ai_review'], function(m) { m.init(); });
{{/aipendingreview}}
{{^aipendingreview}}{{#aistatusisstuck}}
require(['mod_googlemeet/ai_review'], function(m) { m.init(); });
{{/aistatusisstuck}}{{/aipendingreview}}
{{/js}}
