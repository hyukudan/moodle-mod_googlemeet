{{#js}}
require([
  'jquery',
  'core/ajax',
  'core/notification'
], function($, Ajax, Notification) {

  $(document).ready(function() {
    var recordingsScrollKey = 'mod_googlemeet_recordings_anchor_{{coursemoduleid}}';

    function rememberRecordingAnchor(recordingid) {
      var anchor = recordingid ? 'googlemeet-recording-' + recordingid : 'googlemeet_recordings_table';
      try {
        sessionStorage.setItem(recordingsScrollKey, anchor);
      } catch (e) {
        // Ignore storage failures; the hash still gives the browser a best-effort anchor.
      }
      window.location.hash = anchor;
    }

    function reloadRecordingList(recordingid) {
      rememberRecordingAnchor(recordingid);
      window.location.reload();
    }

    function restoreRecordingAnchor() {
      var anchor = '';
      var shouldrestore = false;
      try {
        anchor = sessionStorage.getItem(recordingsScrollKey) || '';
        shouldrestore = anchor !== '';
        sessionStorage.removeItem(recordingsScrollKey);
      } catch (e) {
        anchor = '';
      }
      if (!anchor && window.location.hash) {
        anchor = window.location.hash.substring(1);
        shouldrestore = anchor !== '';
      }
      if (!shouldrestore) {
        return;
      }
      var target = anchor ? document.getElementById(anchor) : null;
      if (!target) {
        target = document.getElementById('googlemeet_recordings_table');
      }
      if (target) {
        setTimeout(function() {
          target.scrollIntoView({block: 'center'});
        }, 80);
      }
      // Drop the anchor from the URL so a later manual refresh does not jump again.
      if (window.location.hash && window.history && window.history.replaceState) {
        window.history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    }

    restoreRecordingAnchor();

    {{#hascapability}}
      // Edit recording name
      $('.recordingeditname').on('click', function() {
        var card = $(this).closest('.googlemeet-card-title');
        var text = card.find('.recording-name-text');
        var editBtn = $(this);
        var recordingid = $(this).attr('data-id');
        var originalname = text.attr('data-originalname') || text.text().trim();

        text.hide();
        editBtn.hide();

        var inputtext = document.createElement('input');
        inputtext.type = 'text';
        inputtext.className = 'form-control googlemeet-edit-input';
        inputtext.id = recordingid;
        inputtext.value = originalname;
        inputtext.setAttribute('data-value', originalname);
        inputtext.addEventListener('keydown', recordingeditkeydown);
        inputtext.addEventListener('focusout', recordingeditonfocusout);

        card.append(inputtext);
        inputtext.focus();
        inputtext.select();
      });

      function recordingeditkeydown(event) {
        var keyCode = event.which || event.keyCode;
        if (keyCode === 13) {
          event.preventDefault();
          event.currentTarget.removeEventListener('focusout', recordingeditonfocusout);
          recordingeditperform(event.currentTarget);
          return;
        }
        if (keyCode === 27) {
          event.currentTarget.removeEventListener('focusout', recordingeditonfocusout);
          recordingeditonfocusout(event.currentTarget);
        }
      }

      function recordingeditperform(element) {
        element = $(element);
        var card = element.closest('.googlemeet-card-title');
        var text = card.find('.recording-name-text');
        var editBtn = card.find('.recordingeditname');

        var loading = $('<span class="googlemeet-inline-loading">{{# pix }} i/processing16, googlemeet, {{# str }} loading, mod_googlemeet {{/ str }} {{/ pix }}</span>');

        text.text(element.val()).show();
        element.hide();
        card.append(loading);

        Ajax.call([{
          methodname: 'mod_googlemeet_recording_edit_name',
          args: {
            recordingid: element.attr('id'),
            name: element.val(),
            coursemoduleid: {{ coursemoduleid }}
          }
        }])[0].then(function(response) {
          text.text(response.displayname || response.name).show();
          text.attr('title', response.name);
          text.attr('data-originalname', response.name);
          $('.googlemeet-ai-edit-btn[data-id="' + element.attr('id') + '"]').attr('data-recordingname', response.name);
          element.remove();
          loading.remove();
          editBtn.show();
        }).fail(Notification.exception).fail(function() {
          text.text(element.attr('data-value')).show();
          element.remove();
          loading.remove();
          editBtn.show();
        });
      }

      function recordingeditonfocusout(element) {
        if (element instanceof FocusEvent) {
          element = $(this);
        } else {
          element = $(element);
        }

        var card = element.closest('.googlemeet-card-title');
        var text = card.find('.recording-name-text');
        var editBtn = card.find('.recordingeditname');
        element.remove();
        text.show();
        editBtn.show();
      }

      // Toggle visibility
      $('.recordinghowhide').on('click', function() {
        var btn = $(this);
        var recordingid = btn.attr('data-id');
        // Works in both views: card grid (.googlemeet-recording-card) and
        // list view (.googlemeet-recording-listitem).
        var card = btn.closest('.googlemeet-recording-card, .googlemeet-recording-listitem');
        var oldContent = btn.html();

        btn.html('{{# pix }} i/processing16, googlemeet, {{# str }} loading, mod_googlemeet {{/ str }} {{/ pix }}');

        Ajax.call([{
          methodname: 'mod_googlemeet_showhide_recording',
          args: {
            recordingid: recordingid,
            coursemoduleid: {{ coursemoduleid }}
          }
        }])[0].then(function(response) {
          var visible = response.visible === true || response.visible === 1 || response.visible === '1' || response.visible === 'true';
          var visibilityLabel = btn.attr(visible ? 'data-label-hide' : 'data-label-show');
          var isListRow = card.hasClass('googlemeet-recording-listitem');
          if (visibilityLabel) {
            btn.attr('title', visibilityLabel);
            btn.attr('aria-label', visibilityLabel);
          }
          if (visible) {
            btn.html('{{# pix }} i/hide, core, {{# str }} hide, mod_googlemeet {{/ str }} {{/ pix }}');
            card.removeClass('googlemeet-recording-hidden');
            if (isListRow) {
              card.find('.googlemeet-listitem-hidden-tag').remove();
            } else {
              card.find('.googlemeet-recording-hidden-badge').remove();
            }
          } else {
            btn.html('{{# pix }} i/show, core, {{# str }} show, mod_googlemeet {{/ str }} {{/ pix }}');
            card.addClass('googlemeet-recording-hidden');
            if (isListRow) {
              if (!card.find('.googlemeet-listitem-hidden-tag').length) {
                card.find('.googlemeet-listitem-title').prepend('<span class="googlemeet-listitem-hidden-tag">{{# str }} recording_hidden, mod_googlemeet {{/ str }}</span>');
              }
            } else {
              if (!card.find('.googlemeet-recording-hidden-badge').length) {
                card.prepend('<div class="googlemeet-recording-hidden-badge">{{# str }} recording_hidden, mod_googlemeet {{/ str }}</div>');
              }
            }
          }
        }).fail(Notification.exception).fail(function() {
          btn.html(oldContent);
        });
      });

      $('.googlemeet-restore-recording').on('click', function() {
        var btn = $(this);
        btn.prop('disabled', true);
        Ajax.call([{
          methodname: 'mod_googlemeet_restore_recording',
          args: {
            recordingid: btn.attr('data-id'),
            coursemoduleid: {{ coursemoduleid }}
          }
        }])[0].then(function() {
          reloadRecordingList(btn.attr('data-id'));
        }).fail(function(ex) {
          btn.prop('disabled', false);
          Notification.exception(ex);
        });
      });

      $('.googlemeet-purge-recording').on('click', function() {
        var btn = $(this);
        Notification.saveCancelPromise(
          '{{# str }} recording_purge, mod_googlemeet {{/ str }}',
          '{{# str }} recording_purge_confirm, mod_googlemeet {{/ str }}',
          '{{# str }} recording_purge, mod_googlemeet {{/ str }}',
          {triggerElement: btn.get(0)}
        ).then(function() {
          btn.prop('disabled', true);
          Ajax.call([{
            methodname: 'mod_googlemeet_purge_recording',
            args: {
              recordingid: btn.attr('data-id'),
              coursemoduleid: {{ coursemoduleid }}
            }
          }])[0].then(function() {
            reloadRecordingList(btn.attr('data-id'));
          }).fail(function(ex) {
            btn.prop('disabled', false);
            Notification.exception(ex);
          });
        }).catch(function() {});
      });

      $('.googlemeet-trash-recording').on('click', function() {
        var btn = $(this);
        Notification.saveCancelPromise(
          '{{# str }} recording_trash, mod_googlemeet {{/ str }}',
          '{{# str }} recording_trash_confirm, mod_googlemeet {{/ str }}',
          '{{# str }} recording_trash, mod_googlemeet {{/ str }}',
          {triggerElement: btn.get(0)}
        ).then(function() {
          btn.prop('disabled', true);
          Ajax.call([{
            methodname: 'mod_googlemeet_trash_recording',
            args: {
              recordingid: btn.attr('data-id'),
              coursemoduleid: {{ coursemoduleid }}
            }
          }])[0].then(function() {
            reloadRecordingList(btn.attr('data-id'));
          }).fail(function(ex) {
            btn.prop('disabled', false);
            Notification.exception(ex);
          });
        }).catch(function() {});
      });
    {{/hascapability}}

  });
});
{{/js}}
