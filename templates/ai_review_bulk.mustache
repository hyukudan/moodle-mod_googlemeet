{{!
    @template mod_googlemeet/ai_review_bulk

    IA-04: activity-level notice for teachers with unreviewed AI summaries.

    Example context (json):
    {
        "cmid": 5,
        "count": 3,
        "message": "3 AI summaries are waiting for your review: students do not see them yet."
    }
}}
<div class="alert alert-warning googlemeet-ai-review-bulk" role="status" data-region="ai-review-bulk">
  <div class="googlemeet-ai-review-banner-text">
    <strong>{{message}}</strong>
    <div class="small">{{# str }} aireview_bulk_hint, mod_googlemeet {{/ str }}</div>
  </div>
  <button type="button" class="btn btn-outline-primary btn-sm" data-action="ai-review-publish-all" data-cmid="{{cmid}}" data-count="{{count}}" data-seen="{{seen}}">{{# str }} aireview_publish_all, mod_googlemeet {{/ str }}</button>
</div>
{{#js}}
require(['mod_googlemeet/ai_review'], function(m) { m.init(); });
{{/js}}
