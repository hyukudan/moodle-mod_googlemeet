{{!
    @template mod_googlemeet/practice_cta

    Hero entry point to the activity-wide practice (students). Rendered inside
    mod_googlemeet/hero with the "practicecta" context.

    Example context (json):
    {
        "practiceurl": "#", "failedurl": "#", "hasfailed": true, "failedlabel": "Repasar mis falladas (3)"
    }
}}
<div class="googlemeet-hero-practice">
  {{#hasfailed}}
    <a href="{{failedurl}}" class="btn btn-outline-primary btn-sm">{{failedlabel}}</a>
  {{/hasfailed}}
  <a href="{{practiceurl}}" class="btn btn-link btn-sm">{{# str }} practice_topic_button, mod_googlemeet {{/ str }}</a>
</div>
